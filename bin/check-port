#!/bin/bash
set -e
source "$(dirname "$0")/common"

help() {
    if [ -n "$1" ]; then
        echo "$1"
    fi
    echo "Usage: bin/check-port [-h|--help] <SERVICE_NAME>"
    exit 1
}

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -h|--help) help ;;
        -*) help "Unknown option $1" ;;
        *) break ;;
    esac
done

if [ "$#" -lt 1 ]; then
    help "Missing required argument: <SERVICE_NAME>"
fi

SERVICE_NAME="$1"

PORT_FILE="var/run/$SERVICE_NAME.port"

if [ ! -f "$PORT_FILE" ]; then
    echo "Error: Network Port file missing for $SERVICE_NAME"
    exit 1
fi

PORT=$(cat "$PORT_FILE")

if nc -z localhost "$PORT" >/dev/null 2>&1; then
    echo "Network Ready (Port $PORT)"
    exit 0
else
    echo "Network Offline (Port $PORT)"
    exit 1
fi
