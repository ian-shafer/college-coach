#!/bin/bash
source "$(dirname "$0")/common"

SERVICE_NAME="$1"

if [ -z "$SERVICE_NAME" ]; then
    echo "Usage: bin/check-port <SERVICE_NAME>"
    exit 1
fi

PORT_FILE="var/run/$SERVICE_NAME.port"

if [ ! -f "$PORT_FILE" ]; then
    echo "Error: Network Port file missing for $SERVICE_NAME"
    exit 1
fi

PORT=$(cat "$PORT_FILE")

if nc -z localhost "$PORT" >/dev/null 2>&1; then
    echo "Network Ready (Port $PORT)"
    exit 0
else
    echo "Network Offline (Port $PORT)"
    exit 1
fi
