#!/bin/bash
set -e
source "$(dirname "$0")/common"

help() {
    if [ -n "$1" ]; then
        log-error "$1"
    fi
    echo "Usage: bin/check-port [-h|--help] <SERVICE_NAME>"
    exit 1
}

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -h|--help) help ;;
        -*) help "Unknown option [$1]" ;;
        *) break ;;
    esac
done

if [ "$#" -ne 1 ]; then
    help "Expected exactly 1 argument: <SERVICE_NAME>"
fi

SERVICE_NAME="$1"

PORT_FILE="var/run/$SERVICE_NAME.port"

if [ ! -f "$PORT_FILE" ]; then
    fatal "No network port file found for [$SERVICE_NAME]"
fi

PORT=$(cat "$PORT_FILE")

if nc -z localhost "$PORT" >/dev/null 2>&1; then
    echo "Port ready: localhost:$PORT"
    exit 0
else
    fatal "Port not ready: localhost:[$PORT]"
fi
