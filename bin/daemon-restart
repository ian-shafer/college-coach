#!/bin/bash
set -e
source "$(dirname "$0")/common"

function help() {
    local msg="$1"
    if [ -n "$msg" ]; then
        log-error "$msg"
    fi
    cat << 'EOF'
Usage: bin/daemon-restart [options] <SERVICE_NAME>

Restarts a background daemon service explicitly executing its stop and start hooks securely.

Options:
-h|--help: prints help message and exits
EOF
    exit 1
}

if [ "$1" == "-h" ] || [ "$1" == "--help" ]; then help; fi

if [ "$#" -ne 1 ]; then
    help "Expected exactly 1 argument: <SERVICE_NAME>"
fi

SERVICE_NAME="$1"

log-info "Restarting [$SERVICE_NAME]..."

"$(dirname "$0")/${SERVICE_NAME}-stop" || true
"$(dirname "$0")/${SERVICE_NAME}-start"

log-info "Successfully restarted [$SERVICE_NAME]."
