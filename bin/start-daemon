#!/bin/bash
set -e
source "$(dirname "$0")/common"

help() {
    if [ -n "$1" ]; then
        echo "$1" >&2
    fi
    echo "Usage: bin/start-daemon [-h|--help] <SERVICE_NAME> <PORT>"
    exit 1
}

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -h|--help) help ;;
        -*) help "Unknown option $1" ;;
        *) break ;;
    esac
done

if [ "$#" -ne 2 ]; then
    help "Expected exactly 2 arguments: <SERVICE_NAME> <PORT>"
fi

SERVICE_NAME="$1"
PORT="$2"

mkdir -p var/run var/log

PID_FILE="var/run/$SERVICE_NAME.pid"
PORT_FILE="var/run/$SERVICE_NAME.port"

if [ -f "$PID_FILE" ]; then
    if bin/check-pid "$SERVICE_NAME" >/dev/null 2>&1; then
        echo "Error: $SERVICE_NAME is already running." >&2
        exit 1
    fi
fi

echo "$PORT" > "$PORT_FILE"

echo "Starting $SERVICE_NAME on port $PORT..."

SERVER_PORT="$PORT" docker compose up "$SERVICE_NAME" > "var/log/$SERVICE_NAME.log" 2>&1 &
PID=$!

echo "$PID" > "$PID_FILE"

if bin/wait-for 30 bin/check-port "$SERVICE_NAME" >/dev/null 2>&1; then
    echo "Successfully started $SERVICE_NAME (PID: $PID)"
    exit 0
else
    echo "Error: $SERVICE_NAME failed to start within 30 seconds." >&2
    kill $PID 2>/dev/null || true
    exit 1
fi
