#!/bin/bash
set -e
source "$(dirname "$0")/common"

help() {
    if [ -n "$1" ]; then
        log-error "$1"
    fi
    cat << 'EOF'
bin/daemon-start [options] <SERVICE_NAME> <DOCKER_COMPOSE_FILE>

Starts a background daemon service explicitly.

Options:
  -p, --port <PORT>    The network port to test when the daemon is started.
  -h, --help           Prints help message and exits.
EOF
    exit 1
}

PORT=""

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -h|--help) help ;;
        -p|--port) PORT="$2"; shift ;;
        --port=*) PORT="${1#*=}" ;;
        -*) help "Unknown option [$1]" ;;
        *) break ;;
    esac
    shift
done

if [ "$#" -ne 2 ]; then
    help "Expected exactly 2 arguments: <SERVICE_NAME> <DOCKER_COMPOSE_FILE>"
fi

SERVICE_NAME="$1"
DOCKER_COMPOSE_FILE="$2"

mkdir -p var/run var/log

PID_FILE="var/run/$SERVICE_NAME.pid"

if [ -f "$PID_FILE" ]; then
    if bin/check-pid "$SERVICE_NAME" >/dev/null 2>&1; then
        fatal "[$SERVICE_NAME] is already running."
    fi
fi

if [ -n "$PORT" ]; then
    echo "Starting $SERVICE_NAME on port $PORT..."
else
    echo "Starting $SERVICE_NAME..."
fi

COMPOSE_CMD=("docker" "compose")
if [ -n "$DOCKER_COMPOSE_FILE" ]; then
    COMPOSE_CMD+=("-f" "$DOCKER_COMPOSE_FILE")
fi

ENV_VARS=()
if [ -n "$PORT" ]; then
    ENV_VARS+=("SERVER_PORT=$PORT")
fi

env "${ENV_VARS[@]}" "${COMPOSE_CMD[@]}" up "$SERVICE_NAME" > "var/log/$SERVICE_NAME.log" 2>&1 &
PID=$!

echo "$PID" > "$PID_FILE"

WAIT_FOR_TIMEOUT=30
if [ -n "$PORT" ]; then
    if bin/wait-for "$WAIT_FOR_TIMEOUT" bin/check-port "$SERVICE_NAME" "$PORT" >/dev/null 2>&1; then
        echo "Successfully started $SERVICE_NAME (PID: $PID) on port $PORT"
        exit 0
    else
        kill $PID 2>/dev/null || true
        fatal "[$SERVICE_NAME] failed to bind port [$PORT] within [$WAIT_FOR_TIMEOUT] seconds."
    fi
else
    echo "Successfully started $SERVICE_NAME (PID: $PID)"
    exit 0
fi
