#!/bin/bash
set -e
source "$(dirname "$0")/common"

help() {
    if [ -n "$1" ]; then
        log-error "$1"
    fi
    cat << EOF
bin/daemon-start [options] <SERVICE_NAME> <DOCKER_COMPOSE_FILE> <PORT>

Starts a background daemon service explicitly.

Options:
-h|--help: prints help message and exits
EOF
    exit 1
}

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -h|--help) help ;;
        -*) help "Unknown option [$1]" ;;
        *) break ;;
    esac
done

if [ "$#" -ne 3 ]; then
    help "Expected exactly 3 arguments: <SERVICE_NAME> <DOCKER_COMPOSE_FILE> <PORT>"
fi

SERVICE_NAME="$1"
DOCKER_COMPOSE_FILE="$2"
PORT="$3"

mkdir -p var/run var/log

PID_FILE="var/run/$SERVICE_NAME.pid"
PORT_FILE="var/run/$SERVICE_NAME.port"

if [ -f "$PID_FILE" ]; then
    if bin/check-pid "$SERVICE_NAME" >/dev/null 2>&1; then
        fatal "[$SERVICE_NAME] is already running."
    fi
fi

echo "$PORT" > "$PORT_FILE"

echo "Starting $SERVICE_NAME on port $PORT..."

COMPOSE_CMD=("docker" "compose")
if [ -n "$DOCKER_COMPOSE_FILE" ]; then
    COMPOSE_CMD+=("-f" "$DOCKER_COMPOSE_FILE")
fi

SERVER_PORT="$PORT" "${COMPOSE_CMD[@]}" up "$SERVICE_NAME" > "var/log/$SERVICE_NAME.log" 2>&1 &
PID=$!

echo "$PID" > "$PID_FILE"

WAIT_FOR_TIMEOUT=30
if bin/wait-for "$WAIT_FOR_TIMEOUT" bin/check-port "$SERVICE_NAME" >/dev/null 2>&1; then
    echo "Successfully started $SERVICE_NAME (PID: $PID)"
    exit 0
else
    kill $PID 2>/dev/null || true
    fatal "[$SERVICE_NAME] failed to start within [$WAIT_FOR_TIMEOUT] seconds."
fi
