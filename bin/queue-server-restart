#!/bin/bash
set -e
source "$(dirname "$0")/common"

help() {
    if [ -n "$1" ]; then
        log-error "$1"
    fi
    cat << 'EOF'
Usage: bin/queue-server-restart [-h|--help]
EOF
    exit 1
}

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -h|--help) help ;;
        -*) help "Unknown option [$1]" ;;
        *) break ;;
    esac
done

if [ "$#" -gt 0 ]; then
    help "Unexpected argument(s) provided: [$*]"
fi

bin/daemon-restart "queue-server"
