#!/bin/bash
set -e
source "$(dirname "$0")/common"

function help() {
    local msg="$1"
    if [ -n "$msg" ]; then
        log-error "$msg"
    fi
    cat << EOF
$(basename "$0") [options]

Drops securely into a live interactive PostgreSQL shell connected to the backend instance.

Options:
-h|--help: prints help message and exits
EOF
    exit 1
}

if [ "$#" -ne 0 ]; then
    if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
        help
        exit 1
    else
        help "Unknown argument: $1"
    fi
fi

DB_NAME="${POSTGRES_DB:-unicoach}"
DB_USER="${POSTGRES_USER:-postgres}"

STATUS=0
./bin/db-status > /dev/null 2>&1 || STATUS=$?

if [ "$STATUS" -eq 1 ]; then
    log-info "Warning: Database Docker instance offline or unreachable."
    exit 1
elif [ "$STATUS" -eq 2 ] || [ "$STATUS" -eq 3 ]; then
    log-info "Warning: Framework uninitialized (Missing target). Connecting to node default..."
    docker compose -f docker/postgres-compose.yml exec postgres psql -U "$DB_USER"
    exit 0
fi

log-info "Accessing [$DB_NAME]..."
docker compose -f docker/postgres-compose.yml exec postgres psql -U "$DB_USER" -d "$DB_NAME"
