#!/bin/bash
set -e
source "$(dirname "$0")/common"

function help() {
    local msg="$1"
    if [ -n "$msg" ]; then
        log-error "$msg"
    fi
    cat << EOF
$(basename "$0") [options]

Checks the holistic health and version state of the database.

Options:
-h|--help: prints message and exits
EOF
    exit 1
}

if [ "$#" -ne 0 ]; then
    if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
        help
        exit 1
    else
        help "Unknown argument: $1"
    fi
fi

# We expect POSTGRES_DB and POSTGRES_USER to be set via .env in common.
DB_NAME="${POSTGRES_DB:-unicoach}"
DB_USER="${POSTGRES_USER:-postgres}"

# Check 1: Process up?
if ! docker compose -f docker/postgres-compose.yml exec postgres pg_isready -U "$DB_USER" >/dev/null 2>&1; then
    fatal "Postgre process offline or unreachable."
fi

# Check 2: Database created?
DB_EXISTS=$(docker compose -f docker/postgres-compose.yml exec postgres psql -U "$DB_USER" -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname='$DB_NAME'" 2>/dev/null || true)
if [ "$DB_EXISTS" != "1" ]; then
    fatal "Database [$DB_NAME] does not exist." 2
fi

# Check 3: Version tracking table missing?
TABLE_EXISTS=$(docker compose -f docker/postgres-compose.yml exec postgres psql -U "$DB_USER" -d "$DB_NAME" -tAc "SELECT EXISTS (SELECT FROM information_schema.tables WHERE table_schema = 'public' AND table_name = 'schema_migrations');" 2>/dev/null || true)
if [ "$TABLE_EXISTS" != "t" ]; then
    fatal "Version tracking table [schema_migrations] missing." 3
fi

# Check 4: Unapplied migrations?
APPLIED_LIST=$(docker compose -f docker/postgres-compose.yml exec postgres psql -U "$DB_USER" -d "$DB_NAME" -tAc "SELECT version FROM schema_migrations" 2>/dev/null || true)

UNAPPLIED_LIST=""
mkdir -p db/schema
for f in db/schema/*.sql; do
    [ -e "$f" ] || continue
    VER=$(basename "$f")
    # Wrap APPLIED_LIST matching to avoid hitting failures on empty lists
    if ! echo "$APPLIED_LIST" | grep -Fxq "$VER"; then
        if [ -n "$UNAPPLIED_LIST" ]; then
            UNAPPLIED_LIST="$UNAPPLIED_LIST, $VER"
        else
            UNAPPLIED_LIST="$VER"
        fi
    fi
done

if [ -n "$UNAPPLIED_LIST" ]; then
    fatal "Unapplied migration scripts: [$UNAPPLIED_LIST]" 4
fi

LATEST_VER=$(docker compose -f docker/postgres-compose.yml exec postgres psql -U "$DB_USER" -d "$DB_NAME" -tAc "SELECT MAX(version) FROM schema_migrations" 2>/dev/null || true)

log-info "Database [$DB_NAME] is fully healthy and synchronized."
if [ -n "$LATEST_VER" ]; then
    log-info "Current Version: [$LATEST_VER]"
else
    log-info "Current Version: [None]"
fi

exit 0
