#!/bin/bash
set -e
source "$(dirname "$0")/common"

help() {
    if [ -n "$1" ]; then
        log-error "$1"
    fi
    cat << 'EOF'
Usage: bin/queue-rm [-h|--help] <MESSAGE_ID>
Removes a specific message entirely from the queue_messages system by ID.
EOF
    exit 1
}

if [ "$#" -ne 1 ] || [ "$1" == "-h" ] || [ "$1" == "--help" ]; then
    help
fi

ID="$1"

log-info "Deleting message ID [$ID]..."
bin/db-query "DELETE FROM queue_messages WHERE id = $ID;"
log-info "Execution bound sent successfully."
