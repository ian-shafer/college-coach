#!/bin/bash
source "$(dirname "$0")/common"

PERIOD=1

while [[ "$#" -gt 0 ]]; do
    case $1 in
        --period|-p) PERIOD="$2"; shift 2 ;;
        *) break ;;
    esac
done

if [ "$#" -lt 2 ]; then
    echo "Usage: bin/wait-for [--period seconds] <timeout> <command...>"
    exit 1
fi

TIMEOUT_VAL="${1%s}"
shift
COMMAND=("$@")

ELAPSED=0
LAST_STATUS=1

while [ $ELAPSED -lt $TIMEOUT_VAL ]; do
    "${COMMAND[@]}"
    LAST_STATUS=$?
    
    if [ $LAST_STATUS -eq 0 ]; then
        exit 0
    fi
    
    sleep $PERIOD
    ELAPSED=$((ELAPSED + PERIOD))
done

exit $LAST_STATUS
