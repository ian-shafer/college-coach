#!/bin/bash
source "$(dirname "$0")/common"

PERIOD="1s"

while [[ "$#" -gt 0 ]]; do
    case $1 in
        --period|-p) PERIOD="$2"; shift 2 ;;
        *) break ;;
    esac
done

if [ "$#" -lt 2 ]; then
    echo "Usage: bin/wait-for [--period duration] <timeout> <command...>"
    exit 1
fi

TIMEOUT_STR="$1"
if [[ ! "$TIMEOUT_STR" =~ ^[0-9]+[smhd]?$ ]]; then
    echo "Error: Invalid timeout format [$TIMEOUT_STR]. Expected a number optionally followed by s, m, h, or d (e.g., 30, 30s, 2m)."
    exit 1
fi
shift
COMMAND=("$@")

# Convert timeout limit to integer seconds supporting s, m, h, d modifiers
TIMEOUT_SECONDS="${TIMEOUT_STR%%[a-zA-Z]*}"
case "$TIMEOUT_STR" in
    *m*) TIMEOUT_SECONDS=$((TIMEOUT_SECONDS * 60)) ;;
    *h*) TIMEOUT_SECONDS=$((TIMEOUT_SECONDS * 3600)) ;;
    *d*) TIMEOUT_SECONDS=$((TIMEOUT_SECONDS * 86400)) ;;
    *s*|*) ;; # seconds is the default unit
esac

SECONDS=0
LAST_STATUS=1

while [ $SECONDS -lt $TIMEOUT_SECONDS ]; do
    "${COMMAND[@]}"
    LAST_STATUS=$?

    if [ $LAST_STATUS -eq 0 ]; then
        exit 0
    fi

    sleep "$PERIOD"
done

exit $LAST_STATUS
