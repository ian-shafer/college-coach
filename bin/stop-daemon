#!/bin/bash
set -e
source "$(dirname "$0")/common"

help() {
    if [ -n "$1" ]; then
        echo "$1"
    fi
    echo "Usage: bin/stop-daemon [-h|--help] <SERVICE_NAME>"
    exit 1
}

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -h|--help) help ;;
        -*) help "Unknown option $1" ;;
        *) break ;;
    esac
done

SERVICE_NAME="$1"

if [ -z "$SERVICE_NAME" ]; then
    help
fi

PID_FILE="var/run/$SERVICE_NAME.pid"
PORT_FILE="var/run/$SERVICE_NAME.port"

if [ ! -f "$PID_FILE" ]; then
    echo "Service $SERVICE_NAME is not running (No PID file)."
    exit 0
fi

PID=$(cat "$PID_FILE")
echo "Stopping $SERVICE_NAME (PID $PID)..."
kill -15 "$PID" >/dev/null 2>&1 || true

bin/wait-for 30 bash -c "! bin/check-pid \"$SERVICE_NAME\" >/dev/null 2>&1"

echo "Service $SERVICE_NAME stopped."
rm -f "$PID_FILE" "$PORT_FILE"
exit 0
