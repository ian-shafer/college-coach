#!/bin/bash
set -e
source "$(dirname "$0")/common"

log-info "Starting unit/integration test bindings (JUnit)..."
docker compose run --rm test-runner || fatal "Unit/Integration tests fail"

log-info "Starting API contract fuzzing tests (Schemathesis)..."
docker compose run --rm api-test || fatal "Schemathesis API fuzzing fail"

log-info "All tests pass."
