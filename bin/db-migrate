#!/bin/bash
set -e
source "$(dirname "$0")/common"

function help() {
    local msg="$1"
    if [ -n "$msg" ]; then
        log-error "$msg"
    fi
    cat << EOF
$(basename "$0") [options]

Sequentially applies unsynced DDL files from db/schema/ wrapped in safe transactions.

Options:
-h|--help: prints help message and exits
EOF
    exit 1
}

if [ "$#" -ne 0 ]; then
    if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
        help
        exit 1
    else
        help "Unknown argument: $1"
    fi
fi

DB_NAME="${POSTGRES_DB:-unicoach}"
DB_USER="${POSTGRES_USER:-postgres}"

STATUS=0
./bin/db-status > /dev/null 2>&1 || STATUS=$?

if [ "$STATUS" -eq 1 ]; then
    fatal "Database instance offline. Cannot migrate."
elif [ "$STATUS" -eq 2 ] || [ "$STATUS" -eq 3 ]; then
    log-info "Database missing initialization structure. Auto-bootstrapping..."
    ./bin/db-init
elif [ "$STATUS" -eq 0 ]; then
    log-info "Database is fully synced. Nothing to migrate."
    exit 0
fi

log-info "Gathering synchronization state..."
APPLIED_LIST=$(docker compose -f docker/postgres-compose.yml exec postgres psql -U "$DB_USER" -d "$DB_NAME" -tAc "SELECT version FROM schema_migrations" 2>/dev/null || true)

# Sort through db/schema locally
mkdir -p db/schema
shopt -s nullglob
FILES=(db/schema/*.sql)
shopt -u nullglob

if [ ${#FILES[@]} -eq 0 ]; then
    log-info "No migration files exist in [db/schema/]."
    exit 0
fi

# Execute migrations chronologically
for file in "${FILES[@]}"; do
    VER=$(basename "$file")
    
    if echo "$APPLIED_LIST" | grep -Fxq "$VER"; then
        continue
    fi
    
    log-info "Migrating: [$VER]"
    # Execute single transaction sequentially using stdin binding with -T to bypass TTY
    (
        echo "BEGIN;"
        cat "$file"
        echo ";"
        echo "INSERT INTO schema_migrations (version) VALUES ('$VER');"
        echo "COMMIT;"
    ) | docker compose -f docker/postgres-compose.yml exec -T postgres psql -U "$DB_USER" -d "$DB_NAME" -v ON_ERROR_STOP=1
    
    log-info "[$VER] applied securely."
done

log-info "All migrations securely applied."
exit 0
