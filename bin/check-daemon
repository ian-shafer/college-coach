#!/bin/bash
set -e
source "$(dirname "$0")/common"

help() {
    if [ -n "$1" ]; then
        echo "$1"
    fi
    echo "Usage: bin/check-daemon [-h|--help] <SERVICE_NAME>"
    exit 1
}

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -h|--help) help ;;
        -*) help "Unknown option $1" ;;
        *) break ;;
    esac
done

SERVICE_NAME="$1"

if [ -z "$SERVICE_NAME" ]; then
    help
fi

if bin/check-pid "$SERVICE_NAME" && bin/check-port "$SERVICE_NAME"; then
    exit 0
else
    exit $?
fi
