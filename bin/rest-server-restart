#!/bin/bash
set -e
source "$(dirname "$0")/common"

help() {
    if [ -n "$1" ]; then
        log-error "$1"
    fi
    echo "Usage: bin/rest-server-restart [-h|--help]"
    exit 1
}

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -h|--help) help ;;
        -*) help "Unknown option [$1]" ;;
        *) break ;;
    esac
done

if [ "$#" -gt 0 ]; then
    help "Unexpected argument(s) provided: [$*]"
fi

bin/rest-server-stop
bin/rest-server-start
