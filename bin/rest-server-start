#!/bin/bash
set -e
source "$(dirname "$0")/common"

help() {
    if [ -n "$1" ]; then
        log-error "$1"
    fi
    cat << 'EOF'
Usage: bin/rest-server-start [-h|--help]

Starts the central Ktor REST engine locally mapping HTTP bounds.
EOF
    exit 1
}

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -h|--help) help ;;
        -*) help "Unknown option [$1]" ;;
        *) break ;;
    esac
done

if [ "$#" -gt 0 ]; then
    help "Unexpected argument(s) provided: [$*]"
fi

bin/daemon-start -p "8080" "rest-server" "docker-compose.yml"
