#!/bin/bash
set -e
source "$(dirname "$0")/common"

help() {
    if [ -n "$1" ]; then
        log-error "$1"
    fi
    cat << 'EOF'
Usage: bin/postgres-start [-h|--help]

Thin wrapper booting the postgres docker composition.
EOF
    exit 1
}

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -h|--help) help ;;
        -*) help "Unknown option [$1]" ;;
        *) break ;;
    esac
    shift
done

if [ "$#" -gt 0 ]; then
    help "Unexpected argument(s) provided: [$*]"
fi

bin/daemon-start -p "${POSTGRES_PORT:-5432}" "postgres" "docker/postgres-compose.yml"
