#!/bin/bash
set -e
source "$(dirname "$0")/common"

help() {
    if [ -n "$1" ]; then
        echo "$1" >&2
    fi
    echo "Usage: bin/check-pid [-h|--help] <SERVICE_NAME>"
    exit 1
}

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -h|--help) help ;;
        -*) help "Unknown option $1" ;;
        *) break ;;
    esac
done

if [ "$#" -ne 1 ]; then
    help "Expected exactly 1 argument: <SERVICE_NAME>"
fi

SERVICE_NAME="$1"

PID_FILE="var/run/$SERVICE_NAME.pid"

if [ ! -f "$PID_FILE" ]; then
    echo "STOPPED (No PID file)" >&2
    exit 1
fi

PID=$(cat "$PID_FILE")

if kill -0 "$PID" >/dev/null 2>&1; then
    echo "RUNNING (PID $PID)"
    exit 0
else
    echo "STOPPED (Stale PID)" >&2
    exit 1
fi
