#!/bin/bash
set -e
source "$(dirname "$0")/common"

help() {
    if [ -n "$1" ]; then
        log-error "$1"
    fi
    cat << 'EOF'
bin/db-query [-h|--help] <QUERY>

Executes an explicit SQL query string seamlessly against the primary PostgreSQL engine.

Options:
  -h, --help           Prints help message and exits.
EOF
    exit 1
}

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -h|--help) help ;;
        -*) help "Unknown option [$1]" ;;
        *) break ;;
    esac
    shift
done

if [ "$#" -ne 1 ]; then
    help "Expected exactly 1 argument: <QUERY>"
fi

QUERY="$1"

DB_NAME="${POSTGRES_DB:-unicoach}"
DB_USER="${POSTGRES_USER:-postgres}"

STATUS=0
./bin/db-status > /dev/null 2>&1 || STATUS=$?

if [ "$STATUS" -eq 1 ]; then
    fatal "Database is unreachable."
elif [ "$STATUS" -eq 2 ] || [ "$STATUS" -eq 3 ]; then
    log-info "Warning: Framework uninitialized (Missing target). Connecting to node default..."
    docker compose -f docker/postgres-compose.yml exec -T postgres psql -U "$DB_USER" -c "$QUERY"
else
    docker compose -f docker/postgres-compose.yml exec -T postgres psql -U "$DB_USER" -d "$DB_NAME" -c "$QUERY"
fi
